{
  "name": "useful-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "typecheck": "/usr/local/bin/node node_modules/typescript/bin/tsc --noEmit",
    "launchd:render": "/usr/local/bin/node --experimental-strip-types scripts/render-launchd.mjs",
    "test": "/usr/local/bin/node --experimental-strip-types --test test/contracts.test.ts test/write-approval.test.ts test/memory.test.ts test/session-owners.test.ts test/eve-stream.test.ts test/shell-store.test.ts test/approvals-persist.test.ts test/session-store.test.ts test/launchd-render.test.ts spikes/s3/approvals.test.ts router/test/contracts.test.ts",
    "verify:release": "/usr/local/bin/node --experimental-strip-types scripts/verify-release.mjs",
    "s1": "/usr/local/bin/node spikes/s1/probe.mjs",
    "start": "/usr/local/bin/node scripts/service.mjs eve",
    "router:start": "/usr/local/bin/node scripts/service.mjs router",
    "web:dev": "/usr/local/bin/node node_modules/next/dist/bin/next dev web --hostname 127.0.0.1 --port 4320",
    "web:build": "/usr/local/bin/node node_modules/next/dist/bin/next build web"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.48",
    "ai": "7.0.99",
    "eve": "0.54.3",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
